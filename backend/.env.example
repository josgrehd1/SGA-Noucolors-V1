# Configuración de Seguridad y Variables de Entorno - SGA NouColors
SECRET_KEY=cambiar_este_secret_key_por_uno_seguro_en_produccion
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Conexión a SAP Service Layer (SQL Server)
SAP_SL_URL=https://192.168.1.156:50000/b1s/v2/
SAP_SERVER=192.168.1.156
SAP_PORT=50000
COMPANY_DB=NOUCOLORS

# Credenciales Usuario Master SAP (para operaciones automáticas/impresiones)
SAP_MASTER_USER=manager
SAP_MASTER_PASSWORD=password_segura_sap

# CORS Origins (Frontend Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
