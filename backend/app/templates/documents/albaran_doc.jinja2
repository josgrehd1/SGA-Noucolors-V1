<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/albaran_doc.css', _external=True) }}">
</head>

<body>
    <div id="header-running">
        <table class="header-table">
            <tr>
                <td width="50%" style="vertical-align: top;">
                    <img src="{{ url_for('static', filename='images/logo.png', _external=True) }}" class="logo">
                </td>
                <td width="50%" class="company-info">
                    <strong>Comercial Nou Colors, S.L.</strong><br>
                    CIF: B12210662<br>
                    CTRA N-340A KM 970, Almazora (Castellón)<br>
                    www.noucolors.com | +34 964 342 980
                </td>
            </tr>
        </table>

        <div
            style="display: table; width: 100%; border-bottom: 2px solid var(--nou-colors-blue, #232634); padding-bottom: 8px; margin-bottom: 15px;">
            <div style="display: table-cell; width: 40%; vertical-align: top;">
                <div class="section-title">CLIENTE</div>
                <strong style="font-size: 11px; color: #111;">{{ albaran.CardName }}</strong><br>
                <span style="color: #555;">{{ albaran.Address }}</span>
            </div>

            <div style="display: table-cell; width: 20%; padding: 0 10px; vertical-align: top;">
                <div class="section-title">ALBARÁN</div>
                <strong>Nº: {{ albaran.DocNum }}</strong>
                <br>
                <strong>Fecha: </strong><span style="color: #555;">{{ albaran.DocDate }}</span>
                {% if albaran.NumAtCard %}
                <br>
                <strong>Ref: </strong><span style="color: #555;">{{ albaran.NumAtCard }}</span>
                {% endif %}
            </div>

            <div style="display: table-cell; width: 40%; vertical-align: top;">
                <div class="section-title">DIRECCIÓN ENVÍO</div>
                <strong style="font-size: 11px; color: #111;">{{ albaran.ShipToCode }}</strong><br>
                <strong>Dirección: </strong><span style="color: #555;">{{ albaran.Address2 }}</span>
            </div>
        </div>
    </div>

    <div id="footer-running" class="bottom-container">
        <div class="important-box">
            <div class="important-title">INFORMACIÓN IMPORTANTE / OBSERVACIONES</div>
            <div style="font-size: 9px; color: #444; margin-bottom: 8px;">
                {{ albaran.Comments or 'Sin observaciones adicionales.' }}
            </div>
        </div>

        <table style="width: 100%; margin-top: 10px; border-top: 1px solid #ccc; padding-top: 5px;">
            <tr>
                <td width="33%" style="text-align: center; font-size: 8px; color: #777;">
                    Página <span class="page"></span> de <span class="topage"></span>
                </td>
                <td width="33%" style="text-align: center; font-size: 8px; color: #777;">
                    Documento generado por SGA NouColors
                </td>
                <td width="33%" style="text-align: right; font-size: 8px; color: #777;">
                    Original para la empresa
                </td>
            </tr>
        </table>
    </div>

    <main>
        <table class="table table-sm table-striped" style="width: 100%; font-size: 10px;">
            <thead style="background-color: #232634; color: white;">
                <tr>
                    <th style="width: 15%;">Código</th>
                    <th style="width: 55%;">Descripción</th>
                    <th style="width: 15%; text-align: right;">Cantidad</th>
                    <th style="width: 15%; text-align: center;">Unidad</th>
                </tr>
            </thead>
            <tbody>
                {% for line in albaran.DocumentLines %}
                <tr>
                    <td><strong>{{ line.ItemCode }}</strong></td>
                    <td>{{ line.ItemDescription }}</td>
                    <td style="text-align: right;"><strong>{{ line.Quantity }}</strong></td>
                    <td style="text-align: center;">{{ line.UnitOfMeasure or 'u.' }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </main>
</body>
</html>
