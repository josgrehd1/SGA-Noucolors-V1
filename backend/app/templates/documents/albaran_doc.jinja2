<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/albaran_doc.css', _external=True) }}">
</head>

<body>
    <div id="header-running">
        <table class="header-table">
            <tr>
                <td width="50%" style="vertical-align: top;">
                    <img src="{{ url_for('static', filename='images/logo.png', _external=True) }}" class="logo">
                </td>
                <td width="50%" class="company-info">
                    <strong>Comercial Nou Colors, S.L.</strong><br>
                    CIF: B12210662<br>
                    CTRA N-340A KM 970, Almazora (Castellón)<br>
                    www.noucolors.com | +34 964 342 980
                </td>
            </tr>
        </table>

        <div
            style="display: table; width: 100%; border-bottom: 2px solid var(--nou-colors-blue); padding-bottom: 8px; margin-bottom: 15px;">
            {% set cab = albaran.CabeceraCalculada if albaran.CabeceraCalculada else None %}
            <div style="display: table-cell; width: 40%; vertical-align: top;">
                <div class="section-title">Cliente {{ albaran.CardCode }}</div>
                <strong style="font-size: 11px; color: #111;">{{ albaran.CardName }}</strong><br>
                {% if cab and cab.LicTradNum %}
                <strong>CIF: </strong><span style="color: #555;">{{ cab.LicTradNum }}</span><br>
                {% endif %}
                <strong>Dir. Fiscal: </strong><span style="color: #555;">{{ cab.DirFactura if cab else albaran.Address }}</span>
            </div>

            <div style="display: table-cell; width: 20%; padding: 0 10px; vertical-align: top;">
                <div class="section-title">Albarán Cliente</div>
                <strong>Nº: {{ cab.NumDocCompleto if cab else albaran.DocNum }}</strong>
                <br>
                <strong>Fecha: </strong><span style="color: #555;">{{ albaran.DocDate | format_date }}</span>
                {% set ref_num = (cab.NumAtCard if (cab and cab.NumAtCard) else (albaran.NumAtCard or albaran.NUMATCARD or albaran.REF_ALBARAN or '')) %}
                <br>
                <strong>Referencia: </strong><span style="color: #555;">{{ ref_num }}</span>
                {% set bultos_show = cab.Bultos if (cab and cab.Bultos) else (albaran.U_MAC_OBSVSTOCK or albaran.U_MAC_ObsVSTOCK or albaran.NumberOfPackages or '1') %}
                <br>
                <strong>Bultos: </strong><span style="color: #555;">{{ bultos_show }}</span>
            </div>

            <div style="display: table-cell; width: 40%; vertical-align: top;">
                <div class="section-title">Dirección Envío</div>
                <strong style="font-size: 11px; color: #111;">{{ albaran.ShipToCode }}</strong><br>
                {% if cab %}
                <span style="color: #555; font-size: 10px;">{{ cab.DireccionEnvio }}</span>
                {% if cab.Contacto %}
                <br>
                <strong>Contacto: </strong><span style="color: #555;">{{ cab.Contacto }}</span>
                {% endif %}
                {% if cab.Telefono %}
                <br>
                <strong>Teléfono: </strong><span style="color: #555;">{{ cab.Telefono }}</span>
                {% endif %}
                {% if cab.Horario %}
                <br>
                <strong>Horario: </strong><span style="color: #555;">{{ cab.Horario }}</span>
                {% endif %}
                {% else %}
                <span style="color: #555; font-size: 10px;">{{ albaran.Address2 }}</span>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="bottom-container">
        <div class="important-box">
            <div class="important-title">IMPORTANTE</div>
            <p style="font-style: italic; margin: 0; font-size: 9px; color: #555; text-align: justify;">
                Dispone de un plazo de 48 horas para verificar que el material recibido es correcto y conforme a su
                pedido; una vez
                transcurrido dicho periodo, no se admitirán reclamaciones.
            </p>
        </div>

        {% if es_valorado %}
        <table class="totals-table">
            <thead>
                <tr>
                    <th>IMPORTE</th>
                    <th>BONIFICACIÓN</th>
                    <th>BASE IMPONIBLE</th>
                    <th>I.V.A. %</th>
                    <th>TOTAL</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{ (albaran.DocTotal - albaran.VatSum) | format_currency }}€</td>
                    <td>0,00€</td>
                    <td>{{ (albaran.DocTotal - albaran.VatSum) | format_currency }}€</td>
                    <td>21,00%</td>
                    <td style="color: var(--nou-colors-blue); font-size: 13px;">
                        {{ albaran.DocTotal | format_currency }}€
                    </td>
                </tr>
            </tbody>
        </table>
        {% endif %}

        <div class="d-flex justify-content-start align-items-stretch gap-3 mt-3">

            <div class="signature-section d-flex flex-column" style="width: 220px;">
                <div class="box-title">CONFORMIDAD CLIENTE</div>
                <div class="box flex-grow-1 d-flex align-items-center justify-content-center text-center">
                    FECHA - FIRMA - SELLO
                </div>
            </div>

            {% set pago = albaran.CondicionesPagoCalculadas if albaran.CondicionesPagoCalculadas else None %}
            <div class="signature-section d-flex flex-column" style="width: 320px;">
                <div class="box-title text-uppercase">Condiciones de Pago</div>
                <div class="box p-2 flex-grow-1 d-flex flex-column justify-content-center text-start text-dark">
                    <div class="mb-1"><strong class="small text-muted">Forma de Pago:</strong>
                        {{ pago.FormaPago if pago else (albaran.FORMA_PAGO | default('CONTADO', true)) }}</div>
                    <div class="mb-1"><strong class="small text-muted">Vía de Pago:</strong>
                        {{ pago.ViaPago if pago else (albaran.VIA_PAGO | default('-', true)) }}</div>
                    <div class="mb-0"><strong class="small text-muted">Domiciliación:</strong>
                        {{ pago.Domiciliacion if pago else (albaran.DOMICILIACION | default('-', true)) }}</div>
                </div>
            </div>

        </div>

        <div class="legal-footer">
            Comercial Nou-Colors. S.L. Inscrita en el Reg. Mercantil de Castellón el 29-1-92, T.510, L.77, Sec.Gral.,
            F.86, H.CS-2090, Ins.1.R - CIF ESB12210662 - RPP ENV/2024/000052542
        </div>
        <div class="page-number"></div>
    </div>

    <table id="tabla-lineas" class="table table-striped align-middle" style="width: 100%; margin-top: 5px;">
        <thead>
            <tr>
                <th style="text-align: left;">ARTÍCULO</th>
                <th style="text-align: center; width: 50px;">CANT.</th>
                {% if es_valorado %}
                <th style="text-align: right; width: 50px;">PRECIO</th>
                <th style="text-align: center; width: 50px;">DTO</th>
                <th style="text-align: right; width: 50px;">IMPORTE</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
            {% set preciosNetos = albaran.U_U_MAC_ImpN == 'S' %}

            {% set ship_code = albaran.ShipToCode.strip() if albaran.ShipToCode else '' %}
            {% set ship_upper = ship_code.upper() %}
            {% set is_generic_ship = ship_upper in ['ENVIO', 'ENVÍO', 'SHIPTO', 'PRINCIPAL', 'DEFAULT', '0', '1', '', 'DIRECCION DE ENVIO', 'DIRECCIÓN DE ENVÍO'] or ship_upper.startswith('ENVIO') or ship_upper.startswith('ENVÍO') %}

            {% if ship_code and not is_generic_ship %}
            <tr>
                <td colspan="{{ (4 if preciosNetos else 5) if es_valorado else 2 }}" style="padding: 6px 8px !important; border-bottom: 1px solid #eee;">
                    <div style="font-size: 11px; font-weight: bold; color: #111; line-height: 1.3;">
                        <span style="display: inline-block; min-width: 50px; font-weight: bold; color: #000;">Info:</span>
                        <span>{{ ship_code }}</span>
                    </div>
                </td>
            </tr>
            {% endif %}

            {% for line in albaran.UnifiedLines %}
            <tr>
                {% if line.LineType in ['dslt_Text', 'dlt_Text'] or not line.ItemCode %}
                {% set texto_info = line.LineText or line.ItemDescription or line.FreeText %}
                <td colspan="{{ (4 if preciosNetos else 5) if es_valorado else 2 }}" style="padding: 5px 8px !important; border-bottom: 1px solid #eee;">
                    <div style="font-size: 11px; font-weight: bold; color: #111; line-height: 1.3;">
                        <span style="display: inline-block; min-width: 50px; font-weight: bold; color: #000;">Info:</span>
                        <span>{{ texto_info }}</span>
                    </div>
                </td>

                {% elif line.LineType == 'dlt_Regular' %}
                <td style="padding: 3px !important;">
                    <table style="width: 100%; border: none; border-collapse: collapse; background: transparent;">
                        <tr>
                            <td style="vertical-align: top; border: none;">
                                <div style="margin-bottom: 2px;">
                                    <span style="font-weight: bold; color: var(--nou-colors-blue); font-size: 11px;">{{ line.ItemDescription }}</span>
                                    <br>
                                    <small style="color: #777; font-size: 9px;">Cod: {{ line.ItemCode }}</small>
                                    {% set texto_linea = line.FreeText or line.ItemDetails or line.Text %}
                                    {% if texto_linea and texto_linea.strip() and texto_linea.strip() != line.ItemDescription.strip() %}
                                    <div style="color: #333; font-size: 9.5px; margin-top: 2px; padding-left: 10px; font-weight: normal;">
                                        {{ texto_linea.strip() }}
                                    </div>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    </table>
                </td>

                <td class="text-center" style="font-weight: bold;">{{ line.Quantity | float }}</td>
                {% if es_valorado %}
                <td class="text-end">{{ (line.LineTotal / line.Quantity) | format_currency }}€</td>
                <td class="text-end" style="font-weight: bold; color: var(--nou-colors-blue);">{{ line.LineTotal | format_currency }}€</td>
                {% endif %}

                {% elif line.LineType == 'dslt_Subtotal' %}
                <td colspan="{{ (3 if preciosNetos else 4) if es_valorado else 1 }}" class="text-end"><strong>{{ line.LineText }}</strong></td>
                {% if es_valorado %}
                <td class="text-end" style="color: var(--nou-colors-blue);"><strong>{{ line.Subtotal | format_currency }}€</strong></td>
                {% endif %}
                {% endif %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
</body>

</html>
